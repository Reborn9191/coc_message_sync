# Use this as a template and export these variables before starting the server.
COLLECTOR_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=replace-with-an-admin-token
DB_PATH=data/messages.db

# OneBot-compatible adapter (NapCat/LLOneBot/etc.).
DRY_RUN=false
ONEBOT_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
QQ_GROUP_ID=123456789

POLL_INTERVAL_SECONDS=1
MAX_ATTEMPTS=8
RETRY_BASE_SECONDS=2
MAX_MESSAGE_LENGTH=2000
COLLECTOR_RATE_LIMIT_PER_MINUTE=120
SYNC_ENABLED=true
MESSAGE_RETENTION_DAYS=30
# Comma-separated substrings rejected before persistence, for example: spamword,广告词
BLOCKED_TERMS=
# Empty means any clan; otherwise use comma-separated clan IDs.
ALLOWED_CLAN_IDS=
